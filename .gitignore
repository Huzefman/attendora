# ============================================================
# Attendora — .gitignore
# Stack: React + TypeScript (frontend), Supabase (DB + Auth + Storage + Edge Functions)
# ============================================================

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/
.vite/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
secrets/
*.pem
*.key
*.crt
*.p12

# Database dumps / backups / local exports
*.sqlite
*.sqlite3
*.db
dump.sql
*.dump
*.jsonl
attendance_records_backup*
*_backup_*.json

# Supabase CLI
supabase/.temp/
supabase/.branches/
supabase/functions/.env

# Editor / IDE
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.history/
*.sublime-project
*.sublime-workspace
!.vscode/extensions.json
!.vscode/tasks.json

# Testing & coverage
coverage/
.nyc_output/

# Logs & temp files
logs/
*.log
tmp/
temp/
.cache/

# Office documents
*.docx
*.xlsx
