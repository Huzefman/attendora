# Attendora — Environment Variables
# Copy this file to .env.local and fill in your project values.
# NEVER commit .env or .env.local.

# ──────────────────────────────────────
# Frontend (Vite)
# ──────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ──────────────────────────────────────
# Bootstrap + demo seed (Node scripts, service role)
# ──────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=<at-least-12-characters>
BOOTSTRAP_OWNER_FIRST_NAME=Ada
BOOTSTRAP_OWNER_LAST_NAME=Lovelace

# Demo data (synthetic; no real people or production data)
DEMO_EMAIL_DOMAIN=example.com
DEMO_PASSWORD=<at-least-12-characters>

# ──────────────────────────────────────
# Edge Functions
# Set locally in supabase/functions/.env, or in the Supabase dashboard.
# The Supabase URL and service-role key are the same values as above.
# ──────────────────────────────────────
APP_NAME=Attendora
SITE_URL=http://localhost:5173
SUPPORT_EMAIL=support@example.com
EMAIL_FROM="Attendora <noreply@example.com>"
RESEND_API_KEY=<resend-key>
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
